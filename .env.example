# Coloca aquí tu clave de API de Google Gemini para habilitar respuestas ilimitadas sobre cualquier tema del mundo
VITE_GEMINI_API_KEY=tu_clave_api_gemini_aqui

# Con esta clave el servidor acuña tokens efímeros para la Gemini Live API y
# Lula habla en tiempo real (voz nativa, micrófono siempre activo y barge-in).
# La clave vive del lado del servidor (middleware de Vite en dev, server.js en
# producción); el navegador solo recibe tokens de un solo uso.
# Modelo y voz opcionales de la Live API:
VITE_GEMINI_LIVE_MODEL=gemini-3.8-live
VITE_GEMINI_LIVE_VOICE=Zephyr
# Endpoint que acuña los tokens efímeros (por defecto /api/token)
# VITE_GEMINI_LIVE_TOKEN_URL=/api/token

# Clave de API de ElevenLabs para voz HD con sincronización labial (Visemas por caracter)
# (solo se usa como respaldo si la Gemini Live API no está disponible)
VITE_ELEVENLABS_API_KEY=tu_clave_api_elevenlabs_aqui
# ID opcional de la voz de ElevenLabs (Por defecto: 21m00Tcm4TlvDq8ikWAM)
VITE_ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM